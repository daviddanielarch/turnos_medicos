{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Hashed bundles can be cached forever; everything else (index.html) must be revalidated
	@immutable path /_expo/* /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /_expo/* /assets/*
	header @mutable Cache-Control "no-cache"

	# Client-side routing: unknown paths fall back to index.html
	try_files {path} /index.html
	file_server
}
